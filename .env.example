# Copie este archivo a .env y complete UNA de las dos claves.
# Groq (gratis): https://console.groq.com/keys
GROQ_API_KEY=
# NVIDIA NIM: https://build.nvidia.com
NVIDIA_API_KEY=

# groq | nvidia
LLM_PROVIDER=groq
# Opcional. Por defecto: openai/gpt-oss-120b (groq) / meta/llama-3.3-70b-instruct (nvidia)
LLM_MODEL=
LLM_TEMPERATURE=0.1
